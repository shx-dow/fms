SQLITE_PATH=data/faculty-reporting.db
UPLOAD_DIR=data/uploads

# Cookie security. When behind plain HTTP on an intranet, set COOKIE_SECURE=false
# (browsers will not send a secure cookie over http). Defaults to true in production.
# COOKIE_SECURE=false

# Explicitly seed demo data on startup. Leave unset (or false) in production so the
# app starts empty and never contains the known demo credentials.
# SEED=true
