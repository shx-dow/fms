# Copy to .env and adjust. Never commit .env itself.

# --- Storage ---
# SQLite database file and attachment directory. Both are created on first run.
SQLITE_PATH=data/faculty-reporting.db
UPLOAD_DIR=data/uploads
MIGRATIONS_DIR=drizzle

# --- HTTP server (adapter-node) ---
# 0.0.0.0 makes the app reachable from other devices on the LAN.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# --- Cookies and CSRF ---
# Leave COOKIE_SECURE unset in production so the session cookie is marked secure.
# Set it to false only when serving plain HTTP with no TLS (e.g. a bare intranet).
# COOKIE_SECURE=false

# Extra origins allowed to POST, comma separated. Use this instead of disabling
# the origin check when Windows/WSL forwarding rewrites the Host header.
# CSRF_TRUSTED_ORIGINS=http://192.168.1.20:3000

# --- Demo data ---
# Leave unset: production starts with an empty database.
# SEED=true

# Seeding a production database is refused unless this is explicitly set to 1.
# ALLOW_PRODUCTION_SEED=1

# --- Backups ---
BACKUP_DIR=backups
BACKUP_RETENTION=14
