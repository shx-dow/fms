{
  "name": "faculty-reporting-system",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-local": "node scripts/reset-local-db.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "npm run check && npm run test:unit",
    "test:unit": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@lucide/svelte": "^1.27.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.3",
    "jspdf": "^4.2.1",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  }
}
